[Unit]
Description=Install default Flatpaks from Flathub
# Runs once, so removed apps stay removed; no network-online wait, which would slow every boot
ConditionPathExists=!/var/lib/cobaltblue/flatpaks-installed
# After the Fedora move, since Flathub copies of apps installed from Fedora would conflict
After=flathub-setup.service flatpak-replace-fedora.service

[Service]
Type=oneshot
StateDirectory=cobaltblue
ExecStart=/usr/bin/sh -c 'xargs -a /usr/share/cobaltblue/flatpaks flatpak install --system --noninteractive --or-update -y flathub'
ExecStart=/usr/bin/touch /var/lib/cobaltblue/flatpaks-installed
ExecStart=/usr/bin/systemctl disable flatpak-preinstall.service
# Retry until the network is up
Restart=on-failure
RestartSec=1min

[Install]
WantedBy=multi-user.target
