[Unit]
Description=Make Flathub the preferred Flatpak remote
ConditionPathExists=/usr/share/cobaltblue/flathub.flatpakrepo

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak remote-add --system --if-not-exists flathub /usr/share/cobaltblue/flathub.flatpakrepo
# Unfiltered and ahead of Fedora's remote (default priority 1)
ExecStart=/usr/bin/flatpak remote-modify --system --enable --no-filter --prio=10 flathub
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
