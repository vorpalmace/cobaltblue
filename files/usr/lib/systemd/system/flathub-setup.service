[Unit]
Description=Ensure Flathub is the only system Flatpak remote
ConditionPathExists=/usr/share/cobaltblue/flathub.flatpakrepo

[Service]
Type=oneshot
# Drop Fedora remotes if present ("-" ignores failure)
ExecStart=-/usr/bin/flatpak remote-delete --system --force fedora
ExecStart=-/usr/bin/flatpak remote-delete --system --force fedora-testing
ExecStart=/usr/bin/flatpak remote-add --system --if-not-exists flathub /usr/share/cobaltblue/flathub.flatpakrepo
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
