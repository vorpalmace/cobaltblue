[Unit]
Description=Set up Flathub as the Flatpak remote
ConditionPathExists=/usr/share/cobaltblue/flathub.flatpakrepo

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak remote-add --system --if-not-exists flathub /usr/share/cobaltblue/flathub.flatpakrepo
# Unfiltered, also on systems set up with Fedora's filtered Flathub
ExecStart=/usr/bin/flatpak remote-modify --system --enable --no-filter flathub
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
